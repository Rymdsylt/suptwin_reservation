<div class="container py-5">
  <h1 class="fw-bold mb-4">Add Table</h1>
  <%= form_with model: @table, url: admin_tables_path, local: true do |f| %>
    <% if @table.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @table.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="mb-3">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-control", required: true, placeholder: "e.g., Table 1" %>
    </div>
    <div class="mb-3">
      <%= f.label :capacity, "Capacity (Max People)", class: "form-label" %>
      <%= f.number_field :capacity, class: "form-control", required: true, min: 1, placeholder: "e.g., 4" %>
    </div>
    <%= f.submit "Create", class: "btn btn-dark" %>
    <%= link_to "Back", admin_tables_path, class: "btn btn-outline-secondary ms-2" %>
  <% end %>
</div>
