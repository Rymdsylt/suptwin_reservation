<div class="container py-5">
  <div class="row">
    <div class="col-lg-8">
      <h1 class="display-4 fw-bold mb-3">Sup Twin! Restobar</h1>
      <p class="lead text-muted mb-4">Good food, great drinks, and a relaxed atmosphere. Make a reservation online.</p>
      <%= link_to "Make a Reservation", availability_path, class: "btn btn-dark btn-lg" %>
    </div>
  </div>
</div>

<div class="container py-5">
  <div class="row">
    <div class="col-md-6 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title fw-bold">Opening Hours</h5>
          <table class="table table-sm mb-0">
            <tr>
              <td>Monday - Thursday</td>
              <td class="text-end">11:00 AM - 10:00 PM</td>
            </tr>
            <tr>
              <td>Friday - Saturday</td>
              <td class="text-end">11:00 AM - 12:00 AM</td>
            </tr>
            <tr>
              <td>Sunday</td>
              <td class="text-end">12:00 PM - 9:00 PM</td>
            </tr>
          </table>
        </div>
      </div>
    </div>
    <div class="col-md-6 mb-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title fw-bold">Contact Us</h5>
          <p class="mb-1"><strong>Address:</strong> 67 Yo Twin, Borrow Dollar 67</p>
          <p class="mb-1"><strong>Phone:</strong> (67) 67-6767</p>
          <p class="mb-0"><strong>Email:</strong> twindollar@suptwin.com</p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="bg-light py-5">
  <div class="container">
    <h2 class="fw-bold mb-4">Make a Reservation</h2>
    <div class="row">
      <div class="col-lg-8">
        <p class="mb-3">Reserve your table online. Select your preferred date, time, and party size.</p>
        <p class="text-muted small mb-4">Note: Reservations must be made at least 2 hours before your booking time.</p>
        <%= link_to "Reserve Now", availability_path, class: "btn btn-dark" %>
      </div>
    </div>
  </div>
</div>
