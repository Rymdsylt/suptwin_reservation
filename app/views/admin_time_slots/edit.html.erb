<div class="container py-5">
  <h1 class="fw-bold mb-4">Edit Time Slot</h1>
  <%= form_with model: @time_slot, url: admin_time_slot_path(@time_slot), method: :patch, local: true do |f| %>
    <div class="mb-3">
      <%= f.label :day, class: "form-label" %>
      <%= f.select :day, Date::DAYNAMES, {}, class: "form-select", required: true %>
    </div>
    <div class="mb-3">
      <%= f.label :start_time, class: "form-label" %>
      <%= f.time_field :start_time, class: "form-control", required: true %>
    </div>
    <div class="mb-3">
      <%= f.label :end_time, class: "form-label" %>
      <%= f.time_field :end_time, class: "form-control", required: true %>
    </div>
    <%= f.submit "Update", class: "btn btn-dark" %>
    <%= link_to "Back", admin_time_slots_path, class: "btn btn-outline-secondary ms-2" %>
  <% end %>
</div>
