<div class="container py-5">
  <h1 class="fw-bold mb-4">Manage Time Slots</h1>
  <%= link_to "Add Time Slot", new_admin_time_slot_path, class: "btn btn-dark mb-3" %>
  <table class="table table-bordered">
    <thead class="table-light">
      <tr>
        <th>Day</th>
        <th>Start Time</th>
        <th>End Time</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @time_slots.each do |slot| %>
        <tr>
          <td><%= slot.day %></td>
          <td><%= slot.start_time.strftime('%I:%M %p') %></td>
          <td><%= slot.end_time.strftime('%I:%M %p') %></td>
          <td>
            <%= link_to "Edit", edit_admin_time_slot_path(slot), class: "btn btn-sm btn-outline-dark" %>
            <%= button_to "Delete", admin_time_slot_path(slot), method: :delete, data: { confirm: "Delete this time slot?" }, class: "btn btn-sm btn-outline-danger ms-2" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
