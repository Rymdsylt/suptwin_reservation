<div class="container py-5">
  <h1 class="fw-bold mb-4">Admin Dashboard</h1>
  <%= link_to "Manage Time Slots", admin_time_slots_path, class: "btn btn-outline-dark mb-4" %>
  <%= link_to "Manage Tables", admin_tables_path, class: "btn btn-outline-dark mb-4 ms-2" %>
  <%= link_to "Manage Reservations", admin_reservations_path, class: "btn btn-outline-dark mb-4 ms-2" %>

  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title">Total Tables</h5>
          <div class="display-6 fw-bold"><%= @total_tables %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title">Time Slots</h5>
          <div class="display-6 fw-bold"><%= @total_time_slots %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title">Total Reservations</h5>
          <div class="display-6 fw-bold"><%= @total_reservations %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title">Upcoming</h5>
          <div class="display-6 fw-bold"><%= @upcoming_reservations.count %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="mb-4">
    <form method="get" action="">
      <label for="date" class="form-label">Select Date</label>
      <input type="date" name="date" id="date" value="<%= @date %>" class="form-control w-auto d-inline-block">
      <button type="submit" class="btn btn-dark ms-2">View</button>
    </form>
  </div>

  <h3 class="fw-bold mb-3">Reservations Today (<%= @date.strftime('%A, %B %d, %Y') %>)</h3>
  <div class="table-responsive mb-4">
    <table class="table table-bordered">
      <thead class="table-light">
        <tr>
          <th>Time Slot</th>
          <th>Table</th>
          <th>Customer</th>
          <th>Party Size</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @reservations_today.each do |r| %>
          <tr>
            <td><%= r.time_slot.display_time %></td>
            <td><%= r.table.name %></td>
            <td><%= r.user.email %></td>
            <td><%= r.party_size %></td>
            <td><span class="badge <%= r.cancelled? ? 'bg-danger' : 'bg-success' %>"><%= r.status.capitalize %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <h3 class="fw-bold mb-3">Upcoming Reservations</h3>
  <div class="table-responsive mb-4">
    <table class="table table-bordered">
      <thead class="table-light">
        <tr>
          <th>Date</th>
          <th>Time Slot</th>
          <th>Table</th>
          <th>Customer</th>
          <th>Party Size</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @upcoming_reservations.each do |r| %>
          <tr>
            <td><%= r.date.strftime('%A, %b %d, %Y') %></td>
            <td><%= r.time_slot.display_time %></td>
            <td><%= r.table.name %></td>
            <td><%= r.user.email %></td>
            <td><%= r.party_size %></td>
            <td><span class="badge <%= r.cancelled? ? 'bg-danger' : 'bg-success' %>"><%= r.status.capitalize %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <h3 class="fw-bold mb-3">Reservations This Week</h3>
  <div class="table-responsive mb-4">
    <table class="table table-bordered">
      <thead class="table-light">
        <tr>
          <th>Date</th>
          <th>Time Slot</th>
          <th>Table</th>
          <th>Customer</th>
          <th>Party Size</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @reservations_week.each do |r| %>
          <tr>
            <td><%= r.date.strftime('%A, %b %d, %Y') %></td>
            <td><%= r.time_slot.display_time %></td>
            <td><%= r.table.name %></td>
            <td><%= r.user.email %></td>
            <td><%= r.party_size %></td>
            <td><span class="badge <%= r.cancelled? ? 'bg-danger' : 'bg-success' %>"><%= r.status.capitalize %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <h3 class="fw-bold mb-3">Reservations This Month</h3>
  <div class="table-responsive mb-4">
    <table class="table table-bordered">
      <thead class="table-light">
        <tr>
          <th>Date</th>
          <th>Time Slot</th>
          <th>Table</th>
          <th>Customer</th>
          <th>Party Size</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @reservations_month.each do |r| %>
          <tr>
            <td><%= r.date.strftime('%A, %b %d, %Y') %></td>
            <td><%= r.time_slot.display_time %></td>
            <td><%= r.table.name %></td>
            <td><%= r.user.email %></td>
            <td><%= r.party_size %></td>
            <td><span class="badge <%= r.cancelled? ? 'bg-danger' : 'bg-success' %>"><%= r.status.capitalize %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
