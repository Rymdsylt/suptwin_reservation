<div class="container py-5">
  <h1 class="fw-bold mb-4">New Reservation</h1>

  <% if @reservation.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @reservation.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @reservation, url: reservations_path, local: true, id: "reservation-form" do |f| %>
    <div class="row g-3">
      <div class="col-md-4">
        <%= f.label :date, class: "form-label" %>
        <%= f.date_field :date, value: @reservation.date || Date.today, class: "form-control", min: Date.today, required: true, readonly: true %>
      </div>
      <div class="col-md-4">
        <%= f.label :time_slot_id, "Time Slot", class: "form-label" %>
        <%= hidden_field_tag 'reservation[time_slot_id]', @reservation.time_slot_id %>
        <input type="text" class="form-control" value="<%= @time_slot&.display_time %>" readonly>
      </div>
      <div class="col-md-4">
        <%= f.label :table_id, "Table", class: "form-label" %>
        <%= f.collection_select :table_id, @available_tables || Table.all.order(:name), :id, ->(t) { "#{t.name} (#{t.capacity} people)" }, { prompt: "Select table" }, { class: "form-select", required: true } %>
      </div>
    </div>

    <div class="row g-3 mt-3">
      <div class="col-md-4">
        <%= f.label :party_size, class: "form-label" %>
        <%= f.number_field :party_size, min: 1, class: "form-control", required: true %>
      </div>
      <div class="col-md-4">
        <%= f.label :contact_name, class: "form-label" %>
        <%= f.text_field :contact_name, class: "form-control", required: true %>
      </div>
      <div class="col-md-4">
        <%= f.label :contact_phone, class: "form-label" %>
        <%= f.telephone_field :contact_phone, class: "form-control", required: true %>
      </div>
    </div>

    <div class="row g-3 mt-3">
      <div class="col-md-6">
        <%= f.label :contact_email, class: "form-label" %>
        <%= f.email_field :contact_email, class: "form-control", required: true %>
      </div>
    </div>

    <div class="mt-4">
      <button type="button" class="btn btn-dark btn-lg" data-bs-toggle="modal" data-bs-target="#confirmReservationModal">Confirm Reservation</button>
      <%= link_to "Back to Availability", availability_path, class: "btn btn-outline-secondary ms-2" %>
    </div>
  <% end %>

  <!-- Reservation Confirmation Modal -->
  <div class="modal fade" id="confirmReservationModal" tabindex="-1" aria-labelledby="confirmReservationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="confirmReservationModalLabel">Confirm Reservation</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          Are you sure you want to confirm this reservation?
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-dark" id="modalConfirmReservation">Yes, Confirm</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var modalConfirmBtn = document.getElementById('modalConfirmReservation');
      if (modalConfirmBtn) {
        modalConfirmBtn.addEventListener('click', function() {
          var form = document.getElementById('reservation-form');
          if (form) { form.submit(); }
        });
      }
    });
  </script>
</div>
