<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-body p-5">
          <h2 class="fw-bold mb-4 text-success">
            <i class="bi bi-check-circle-fill me-2"></i>Reservation Confirmed!
          </h2>
          <p class="lead mb-4">Thank you for booking with <strong>Sup Twin! Restobar</strong>.</p>

          <h5 class="fw-bold mb-3">Reservation Details</h5>
          <table class="table table-borderless mb-4">
            <tr>
              <th>Date:</th>
              <td><%= @reservation.date.strftime('%A, %B %d, %Y') %></td>
            </tr>
            <tr>
              <th>Time Slot:</th>
              <td><%= @reservation.time_slot.display_time %></td>
            </tr>
            <tr>
              <th>Table:</th>
              <td><%= @reservation.table.name %> (up to <%= @reservation.table.capacity %> people)</td>
            </tr>
            <tr>
              <th>Party Size:</th>
              <td><%= @reservation.party_size %></td>
            </tr>
            <tr>
              <th>Name:</th>
              <td><%= @reservation.contact_name %></td>
            </tr>
            <tr>
              <th>Phone:</th>
              <td><%= @reservation.contact_phone %></td>
            </tr>
            <tr>
              <th>Email:</th>
              <td><%= @reservation.contact_email %></td>
            </tr>
            <tr>
              <th>Status:</th>
              <td><span class="badge bg-success"><%= @reservation.status.capitalize %></span></td>
            </tr>
          </table>

          <div class="d-flex gap-2">
            <%= link_to "My Reservations", my_reservations_path, class: "btn btn-outline-dark" %>
            <%= link_to "Back to Home", root_path, class: "btn btn-link" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
