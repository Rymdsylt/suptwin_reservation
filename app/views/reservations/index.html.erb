<div class="container py-5">
  <h1 class="fw-bold mb-4">My Reservations</h1>

  <% if @reservations.empty? %>
    <div class="alert alert-info">You have no reservations yet.</div>
  <% else %>
    <div class="table-responsive">
      <table class="table table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Time Slot</th>
            <th>Table</th>
            <th>Party Size</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @reservations.each do |reservation| %>
            <tr>
              <td><%= reservation.date.strftime('%A, %b %d, %Y') %></td>
              <td><%= reservation.time_slot.display_time %></td>
              <td><%= reservation.table.name %></td>
              <td><%= reservation.party_size %></td>
              <td>
                <% if reservation.cancelled? %>
                  <span class="badge bg-danger">Cancelled</span>
                <% else %>
                  <span class="badge bg-success">Confirmed</span>
                <% end %>
              </td>
              <td>
                <%= link_to "View", reservation_path(reservation), class: "btn btn-sm btn-outline-dark" %>
                <% unless reservation.cancelled? %>
                  <button type="button" class="btn btn-sm btn-outline-danger ms-2" data-bs-toggle="modal" data-bs-target="#cancelReservationModal-<%= reservation.id %>">Cancel</button>

                  <!-- Cancel Confirmation Modal -->
                  <div class="modal fade" id="cancelReservationModal-<%= reservation.id %>" tabindex="-1" aria-labelledby="cancelReservationModalLabel-<%= reservation.id %>" aria-hidden="true">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="cancelReservationModalLabel-<%= reservation.id %>">Cancel Reservation</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          Are you sure you want to cancel this reservation?
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                          <%= button_to "Yes, Cancel", cancel_reservation_path(reservation), method: :patch, form: { class: "d-inline" }, class: "btn btn-danger" %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
