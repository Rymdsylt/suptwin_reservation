<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card">
        <div class="card-body p-4">
          <h2 class="card-title fw-bold mb-4">Register</h2>

          <%= form_with model: @user, url: register_path, local: true do |f| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :password, class: "form-label" %>
              <%= f.password_field :password, class: "form-control", required: true %>
              <div class="form-text">Minimum 6 characters</div>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
              <%= f.password_field :password_confirmation, class: "form-control", required: true %>
            </div>

            <div class="d-grid">
              <%= f.submit "Register", class: "btn btn-dark" %>
            </div>
          <% end %>

          <hr class="my-4">

          <p class="text-center mb-0">
            Already have an account? <%= link_to "Login", login_path %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
